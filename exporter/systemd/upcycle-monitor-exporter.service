# Install this unit on the physical host after defining the exporter command and environment.
[Unit]
Description=Upcycle Monitor host telemetry exporter
After=network-online.target

[Service]
# Install the exporter into this virtual environment before enabling the unit.
EnvironmentFile=-/etc/upcycle-monitor/exporter.env
WorkingDirectory=/opt/upcycle-monitor/exporter
ExecStart=/opt/upcycle-monitor/exporter/.venv/bin/python -m monitor_exporter
Restart=on-failure

[Install]
WantedBy=multi-user.target
