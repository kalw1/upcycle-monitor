# Exporter device locations (the folder names vary by host).
POWER_SUPPLY_ROOT=/sys/class/power_supply
BATTERY_FOLDER=BAT1
AC_FOLDER=ACAD

# Exporter runtime settings.
EXPORTER_BACKEND_URL=http://backend:8000
EXPORTER_AUTH_TOKEN=
EXPORTER_COLLECTION_INTERVAL_SECONDS=30
EXPORTER_LOG_LEVEL=INFO

# Optional per-statistic filename overrides. Defaults match Linux power_supply sysfs.
# BATTERY_CAPACITY_FILE=capacity
# BATTERY_STATUS_FILE=status
# AC_ONLINE_FILE=online
